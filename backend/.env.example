SIFT_ENV=development
SIFT_LOG_LEVEL=INFO
SIFT_DATABASE_URL=sqlite:///./.data/sift.db

# Model runtime provider profiles: openai, deepseek, openrouter, nous, kimi, custom, mock.
SIFT_RUNTIME_PROVIDER=custom
SIFT_RUNTIME_BASE_URL=https://api.openai.com/v1
SIFT_RUNTIME_API_KEY=
SIFT_RUNTIME_MODEL=gpt-5.5

# Web retrieval provider profiles: ddgs, tavily, disabled.
SIFT_RUNTIME_WEB_SEARCH_ENABLED=true
SIFT_WEB_SEARCH_PROVIDER=ddgs
SIFT_WEB_SEARCH_API_KEY=
