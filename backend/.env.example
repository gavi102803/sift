SIFT_ENV=development
SIFT_AUTH_MODE=development
SIFT_LOG_LEVEL=INFO
SIFT_DATABASE_URL=sqlite:///./.data/sift.db
SIFT_BETA_INVITE_CODES=
SIFT_BETA_TOKEN_TTL_DAYS=30

# Managed beta production example (supply values through the host secret manager):
# SIFT_ENV=production
# SIFT_AUTH_MODE=managed
# SIFT_DATABASE_URL=postgresql+psycopg://sift:<password>@<host>:5432/sift
# SIFT_BETA_INVITE_CODES=<single-use-code-1>,<single-use-code-2>
